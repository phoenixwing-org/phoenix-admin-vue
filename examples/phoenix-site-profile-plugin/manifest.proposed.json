{
	"formatVersion": 2,
	"pluginType": "phoenix.admin.branding",
	"moduleId": "sample-site-profile",
	"name": "示例站点外观",
	"version": "0.1.0",
	"publisher": "Example Organization",
	"license": "MIT",
	"hostCompatibility": "^0.2.3",
	"wingCompatibility": "^0.6.4",
	"activationMode": "restart",
	"routePrefix": "/sample-site-profile",
	"entrypoints": {
		"web": "dist/web.js",
		"node": "dist/node.js"
	},
	"routes": [
		{
			"id": "sample-site-profile-home",
			"path": "/sample-site-profile/home",
			"title": "欢迎",
			"icon": "pnw:home",
			"moduleId": "sample-site-profile-workbench",
			"capability": "sample-site-profile:home:read",
			"viewPath": "modules/sample-site-profile/views/home.vue",
			"isShow": true
		}
	],
	"navigation": {
		"preferredGroupId": "pah-group-business",
		"preferredGroupLabel": "业务",
		"modules": [
			{
				"id": "sample-site-profile-workbench",
				"label": "示例首页",
				"icon": "pnw:home",
				"routeIds": ["sample-site-profile-home"]
			}
		]
	},
	"apiPrefix": "/admin/sample-site-profile/",
	"capabilities": [
		{
			"id": "sample-site-profile:home:read",
			"description": "查看示例站点首页",
			"risk": "read"
		},
		{
			"id": "sample-site-profile:purge",
			"description": "清理示例站点配置",
			"risk": "admin"
		}
	],
	"resourcePolicies": [],
	"auditCategories": [],
	"migrations": [],
	"healthChecks": [],
	"hostReuse": ["identity", "menus", "audit", "parameters"],
	"dataOwnership": {
		"tables": [],
		"retainedOnUninstall": true
	},
	"uninstall": {
		"retainDataByDefault": true,
		"requiresBackup": false,
		"purgeCapability": "sample-site-profile:purge"
	},
	"uiContributions": {
		"contractVersion": 1,
		"login": {
			"id": "sample-site-profile-login",
			"mode": "host-auth-shell",
			"title": "欢迎使用 Acme Workspace",
			"subtitle": "使用管理员分配的账号安全登录"
		},
		"home": {
			"id": "sample-site-profile-home-selection",
			"routeId": "sample-site-profile-home"
		},
		"brand": {
			"id": "sample-site-profile-brand",
			"appName": "Acme Workspace",
			"logo": "assets/logo.svg",
			"logoDark": "assets/logo-dark.svg",
			"compactLogo": "assets/logo-compact.svg",
			"compactLogoDark": "assets/logo-compact-dark.svg",
			"favicon": "assets/favicon.svg",
			"titleTemplate": "%s · Acme Workspace",
			"showFrameworkBranding": false
		}
	}
}
